# 复制成 .env 后 chmod 600；不要提交 .env。
# --- MySQL（compose 首次启动创建库和用户；表由平台启动时自动建）---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=aiops
MYSQL_USER=aiops
MYSQL_PASSWORD=change-me-aiops
MYSQL_PORT=3307

# --- 容器 UID/GID ---
# compose 把宿主机 data/ 绑定进容器；容器用户必须能读写这些 0600 文件。
# Linux/macOS 填当前用户：AIOPS_UID=$(id -u)、AIOPS_GID=$(id -g)。
# 必填；不填 compose 启动时直接报错，避免容器读不到 0600 文件。
AIOPS_UID=1000
AIOPS_GID=1000

# 宿主机直接跑 npm start 时用；容器里 compose 会覆盖成 mysql:3306。
AIOPS_DB_HOST=127.0.0.1
AIOPS_DB_PORT=3307
AIOPS_DB_USER=aiops
AIOPS_DB_PASSWORD=change-me-aiops
AIOPS_DB_NAME=aiops
AIOPS_DB_CONNECT_TIMEOUT_MS=60000

# --- 账号模式 ---
AIOPS_AUTH=local
AIOPS_ADMIN_USERNAME=admin
# 首次启动空库时创建管理员；登录后立即改密，然后从 .env 移除这一行。
AIOPS_ADMIN_PASSWORD=change-me-admin
# 可选：覆盖 config/platform.json 的 internalToken；K8s 从 Secret 注入。
# AIOPS_INTERNAL_TOKEN=
# 外部注入加密密钥；不设置时用 data/secret.key（0600）。生产二选一，备份要覆盖。
# AIOPS_SECRET_KEY=
# AIOPS_SECRET_KEY_FILE=/app/data/secret.key

# --- 外部访问 / HTTPS ---
# 反向代理或远程 DSH 打开页面时，审批深链和告警回调的基地址。
# 内网 HTTP 写 http://<IP或域名>:<端口>；启用 TLS 再写 https://...
AIOPS_PUBLIC_URL=http://127.0.0.1:8787
# 平台宿主机监听地址；只给本机用 127.0.0.1，局域网访问用 0.0.0.0。
# AIOPS_BIND_ADDR=127.0.0.1
# 反向代理终结 TLS 时设为 1，会话 Cookie 加 Secure；内网 HTTP 必须保持 0/不设置。
# AIOPS_COOKIE_SECURE=1
# 只有平台不能绕过反向代理/Ingress 直接访问时才设 1；从最右侧 XFF 取客户端 IP。
# 直接暴露时不要开，否则客户端可以伪造 X-Forwarded-For。
# AIOPS_TRUST_PROXY=1
# 平台自己终结 TLS 时同时设置；只设一个会拒绝启动。
# AIOPS_TLS_CERT_FILE=/app/certs/fullchain.pem
# AIOPS_TLS_KEY_FILE=/app/certs/privkey.pem

# --- MCP 认证 ---
# MCP 的 token 直接写在各自目录（deploy/mcp-*）的 nginx.conf，登录平台后在
# 「能力 → MCP」粘贴同一个值，平台加密落盘，这里不需要定义。
# 确实要用环境变量注入 header（值写 "Bearer ${ENV_NAME}"，请求时解析）时再在这里加。

# --- 模型（可选）---
# AIOPS_MODEL_BASE_URL=https://api.deepseek.com/v1
# AIOPS_MODEL_NAME=deepseek-chat
# AIOPS_MODEL_API_KEY=
# AIOPS_MODEL_MAX_STEPS=8
# AIOPS_MODEL_TOOL_OUTPUT_CHARS=30000
# AIOPS_MODEL_STREAM=1
# AIOPS_MODEL_MAX_RETRIES=2
# AIOPS_MODEL_RETRY_BACKOFF_MS=500
# AIOPS_MODEL_INPUT_COST_PER_1M=
# AIOPS_MODEL_OUTPUT_COST_PER_1M=
# AIOPS_MODEL_CURRENCY=USD

# --- 通用限流 ---
# AIOPS_RATE_LIMIT_WINDOW_MS=60000
# AIOPS_RATE_LIMIT_MAX=1200
# AIOPS_RATE_LIMIT_WRITE_MAX=60
# AIOPS_RATE_LIMIT_LOGIN_MAX=15
# AIOPS_RATE_LIMIT_DISABLED=0

# --- 可观测性 ---
# AIOPS_LOG_REQUESTS=1
# 对外或共享网络必须设置；不设置时 /metrics 匿名可读。
# AIOPS_METRICS_TOKEN=
# AIOPS_MCP_HEALTH_MS=30000

# --- 远程 MCP 会话（/mcp）---
# 闲置回收时间，默认 43200000（12 小时），最低 60000；0 表示不按时间回收。
# AIOPS_MCP_SESSION_TTL_MS=43200000
# 同时保留的会话数上限，默认 200，范围 1-1000。
# AIOPS_MCP_MAX_SESSIONS=200

# --- 告警接入 ---
# AIOPS_ALERT_SOURCES_FILE=/app/data/alert-sources.json
# AIOPS_ALERT_MAX_CONCURRENCY=3