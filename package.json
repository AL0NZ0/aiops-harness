{
  "name": "aiops-harness",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env api/src/main.ts",
    "start": "tsx --env-file-if-exists=.env api/src/main.ts",
    "start:mcp": "AIOPS_CONFIG=config/platform.mcp.json tsx --env-file-if-exists=.env api/src/main.ts",
    "mcp": "tsx --env-file-if-exists=.env extensions/mcp/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "AIOPS_AUTH= AIOPS_MODEL_DISABLE=1 AIOPS_MODEL_PROVIDERS_FILE=/tmp/aiops-test-model-providers-$$.json AIOPS_NOTIFICATIONS_FILE=/tmp/aiops-test-notifications-$$.json tsx --env-file-if-exists=.env --test api/test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/api/src/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.6",
    "ssh2": "^1.17.0"
  },
  "description": "围绕外部 Agent 引擎的 AIOps 扩展层：知识、MCP 接入、任务与审批、审计、资产/SSH 凭证和 Web 控制台。",
  "license": "Apache-2.0"
}
